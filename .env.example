# HTTP and persistence. JSON is the default local/test driver; MySQL credentials
# are only required when STORAGE_DRIVER=mysql. Never commit a real password.
PORT=8876
# Optional Vite development proxy override when the backend uses a non-default port.
VITE_API_PROXY_TARGET=http://127.0.0.1:8876
STORAGE_DRIVER=json
# Vercel production option: Redis persistence through an Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_STORE_KEY=lingxi:store:v1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_resume_coach
MYSQL_USER=lingxi_app
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=4
JOB_CONCURRENCY=1
# Use inline on stateless serverless hosts so queued AI work finishes before the request ends.
JOB_EXECUTION_MODE=background

# AI provider. Empty values fail visibly; no local result is substituted.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_TIMEOUT_MS=20000

# Server-only vector indexing configuration. Leave API keys empty in local templates.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=2

QDRANT_URL=http://127.0.0.1:6333
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=lingxi_knowledge
QDRANT_TIMEOUT_MS=10000

# Alternative Vercel-native vector store. When configured, it uses Upstash's
# server-side BGE-M3 embeddings, so EMBEDDING_API_KEY is not required.
VECTOR_STORE_DRIVER=qdrant
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_MODEL=BAAI/bge-m3
UPSTASH_VECTOR_DIMENSION=1024
UPSTASH_VECTOR_NAMESPACE=lingxi_knowledge

# Optional reranking; disabled or incomplete configuration falls back to RRF.
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TOP_N=20
RERANKER_TIMEOUT_MS=15000
